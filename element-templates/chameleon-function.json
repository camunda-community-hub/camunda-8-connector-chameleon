{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Chameleon function",
  "id": "io.camunda.connector.chameleon.ChameleonFunction",
  "description": "Simulate any connector",
  "documentationRef": "https://docs.camunda.io/docs/components/modeler/web-modeler/connectors/available-connectors/template/",
  "icon": {
    "contents": "data:image/png;base64,"
  },
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:ServiceTask"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "ping",
      "label": "Ping"
    },
    {
      "id": "errors",
      "label": "errors"
    },
    {
      "id": "operations",
      "label": "operations"
    },
    {
      "id": "documents",
      "label": "documents"
    },
    {
      "id": "Input",
      "label": "Input"
    },
    {
      "id": "Output",
      "label": "Output"
    }
  ],
  "properties": [
    {
      "binding": {
        "type": "zeebe:taskDefinition:type"
      },
      "type": "Hidden",
      "value": "c-chameleon-function"
    },
    {
      "binding": {
        "key": "resultVariable",
        "type": "zeebe:taskHeader"
      },
      "type": "Hidden",
      "value": "result"
    },
    {
      "id": "sleep",
      "label": "Sleep time (ms)",
      "description": "Sleep time to simulate a real connector",
      "value": "0",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "sleep",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Input"
    },
    {
      "id": "pingSimulation",
      "label": "Ping simulation?",
      "description": "Ping simulation?",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "binding": {
        "name": "pingSimulation",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "ping"
    },
    {
      "condition": {
        "property": "pingSimulation",
        "oneOf": [
          "true"
        ]
      },
      "id": "pingMessage",
      "label": "Ping Message",
      "description": "A message is get to log it, and return",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "pingMessage",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "ping"
    },
    {
      "id": "errorSimulation",
      "label": "Error simulation?",
      "description": "Error simulation?",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "binding": {
        "name": "errorSimulation",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "errors"
    },
    {
      "condition": {
        "property": "errorSimulation",
        "oneOf": [
          "true"
        ]
      },
      "id": "throwErrors",
      "label": "Throws error rule",
      "description": "Give a list of error code/percentage of execution. Example [ { \"code\": \"NULLPOINTER\", \"%\": 23, \"message\":\"this is the message\"}, { \"code\": \"BADAMOUNT\", \"%\": 10}]",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "throwErrors",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "errors"
    },
    {
      "id": "operationSimulation",
      "label": "Operation simulation?",
      "description": "Operation simulation?",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "binding": {
        "name": "operationSimulation",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "operations"
    },
    {
      "condition": {
        "property": "operationSimulation",
        "oneOf": [
          "true"
        ]
      },
      "id": "operations",
      "label": "Operations",
      "description": "map of operation to execute. Structure is { \"\u003cvariableName\"\u003e : \"operation\"}. Operation is a value (string, or process variable reference) or \u003cfunction\u003e(\u003cparams\u003e).Functions are date,datetime,localdate,Localtime,zoneddatetime",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "operations",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "operations"
    },
    {
      "id": "documentSimulation",
      "label": "Document simulation?",
      "description": "Document simulation?",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "binding": {
        "name": "documentSimulation",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "documents"
    },
    {
      "condition": {
        "property": "documentSimulation",
        "oneOf": [
          "true"
        ]
      },
      "id": "readDocumentName",
      "label": "Read document name",
      "description": "Read a document",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "readDocumentName",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "documents"
    },
    {
      "condition": {
        "property": "documentSimulation",
        "oneOf": [
          "true"
        ]
      },
      "id": "writeDocumentName",
      "label": "Write document name",
      "description": "Write a document with this name",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "writeDocumentName",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "documents"
    },
    {
      "condition": {
        "property": "documentSimulation",
        "oneOf": [
          "true"
        ]
      },
      "id": "writeDocumentContent",
      "label": "Write document content",
      "description": "Content of the document to write",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "writeDocumentContent",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "documents"
    },
    {
      "id": "pingTimeStampMS_optional",
      "label": "Saved Ping Time stamp?",
      "description": "if a Ping is required, then produce this information",
      "value": "false",
      "binding": {
        "name": "pingTimeStampMS_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "Output"
    },
    {
      "condition": {
        "property": "pingTimeStampMS_optional",
        "equals": "true"
      },
      "id": "pingTimeStampMS",
      "label": "Ping Time stamp",
      "description": "if a Ping is required, then produce this information",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.pingTimeStampMS",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "id": "pingIpAddress_optional",
      "label": "Saved Ping IP Address?",
      "description": "if a Ping is required, then produce this information",
      "value": "false",
      "binding": {
        "name": "pingIpAddress_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "Output"
    },
    {
      "condition": {
        "property": "pingIpAddress_optional",
        "equals": "true"
      },
      "id": "pingIpAddress",
      "label": "Ping IP Address",
      "description": "if a Ping is required, then produce this information",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.pingIpAddress",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "id": "pingMessage_optional",
      "label": "Saved Ping Message?",
      "description": "if a Ping is required, then save the ping message",
      "value": "false",
      "binding": {
        "name": "pingMessage_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "Output"
    },
    {
      "condition": {
        "property": "pingMessage_optional",
        "equals": "true"
      },
      "id": "pingMessage",
      "label": "Ping Message",
      "description": "if a Ping is required, then save the ping message",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.pingMessage",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "id": "documentWrite_optional",
      "label": "Saved Document Write?",
      "description": "Reference to the document created by the connector",
      "value": "false",
      "binding": {
        "name": "documentWrite_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "Output"
    },
    {
      "condition": {
        "property": "documentWrite_optional",
        "equals": "true"
      },
      "id": "documentWrite",
      "label": "Document Write",
      "description": "Reference to the document created by the connector",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.documentWrite",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "id": "operationValue_optional",
      "label": "Saved Operation Value?",
      "description": "if an Operation is required, result of all operations as a map",
      "value": "false",
      "binding": {
        "name": "operationValue_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "Output"
    },
    {
      "condition": {
        "property": "operationValue_optional",
        "equals": "true"
      },
      "id": "operationValue",
      "label": "Operation Value",
      "description": "if an Operation is required, result of all operations as a map",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.operationValue",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "label": "ControllerPage Expression",
      "description": "Expression to define BPMN Errors to throw",
      "type": "Hidden",
      "value": "if is defined(error) then bpmnError(error.code, error.message) else null",
      "binding": {
        "key": "errorExpression",
        "type": "zeebe:taskHeader"
      }
    }
  ]
}