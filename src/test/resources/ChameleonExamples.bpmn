          <zeebe:input source="true" target="errorSimulation" />
          <zeebe:input source="= [ { &#34;code&#34;: &#34;BAD_AMOUNT&#34;, &#34;%&#34;: 50,&#10;     &#34;message&#34;:&#34;Amount must be positive&#34;}, &#10;   { &#34;code&#34;: &#34;BAD_ACCOUNT&#34;, &#34;%&#34;: 50}]" target="throwErrors" />
          <zeebe:input source="false" target="operationSimulation" />
          <zeebe:input source="false" target="documentSimulation" />
          <zeebe:input source="false" target="pingTimeStampMS_optional" />
          <zeebe:input source="false" target="pingIpAddress_optional" />
          <zeebe:input source="false" target="pingMessage_optional" />
          <zeebe:input source="false" target="documentWrite_optional" />
